    "synth": "npm run build && cdk synth --app \"node dist/bin/ai-assist-infra.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.198.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "aws-cdk": "^2.1021.0",
    "typescript": "^5.8.3"
  }
}
